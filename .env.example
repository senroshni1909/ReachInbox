# =============================================================================
# ReachInbox Production Environment Variables
# Copy to .env on your VPS before running `docker compose up -d`
# =============================================================================

# Frontend URL (Replace with your VPS Public IP or Domain)
# Example: http://123.45.67.89 or https://mail.yourdomain.com
FRONTEND_URL=http://localhost

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=reachinbox_secure_password_2026
POSTGRES_DB=reachinbox_db
POSTGRES_PORT=5432

# Redis & BullMQ Configuration
REDIS_PORT=6379
REDIS_PASSWORD=reachinbox_redis_secure_pass_2026

# Email / SMTP Credentials (Default Ethereal fake credentials or your real SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dean.prosacco@ethereal.email
SMTP_PASS=pfyMsQUR5hzmPuPNAq

# Rate Limiter & Concurrency Settings
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR_DEFAULT=50
MIN_DELAY_BETWEEN_EMAILS_SECONDS=2

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=
