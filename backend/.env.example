# Environment Configuration for ReachInbox Backend
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public"

# Redis Connection (BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting Configuration
MAX_EMAILS_PER_HOUR_DEFAULT=50
MIN_DELAY_BETWEEN_EMAILS_SECONDS=2
WORKER_CONCURRENCY=5

# Ethereal Fake SMTP Credentials (auto-generated or configured)
ETHEREAL_USER=
ETHEREAL_PASS=

# Slack Integration (OAuth / Webhook)
SLACK_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
