{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "Production-grade BullMQ + Redis Email Job Scheduler with Prisma ORM",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "redis:logs": "docker compose logs -f redis",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bullmq": "^6.7.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
