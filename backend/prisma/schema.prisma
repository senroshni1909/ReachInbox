// Prisma Schema for ReachInbox Email Scheduler
// Supports PostgreSQL (Recommended for production) & MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SCHEDULED
  DELAYED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  name          String
  avatar        String?
  googleId      String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  emailJobs     EmailJob[]
  slackConfigs  SlackIntegration[]

  @@map("users")
}

model Sender {
  id          String     @id @default(uuid())
  email       String     @unique
  name        String?
  hourlyLimit Int        @default(50)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  emailJobs   EmailJob[]

  @@map("senders")
}

model EmailJob {
  id                 String     @id @default(uuid())
  // Maps directly to the BullMQ persistent delayed job ID for crash recovery and idempotency
  bullJobId          String?    @unique
  recipient          String
  recipientName      String?
  subject            String
  body               String     @db.Text
  senderEmail        String
  sender             Sender     @relation(fields: [senderEmail], references: [email], onDelete: Cascade)
  scheduledTime      DateTime
  sentTime           DateTime?
  status             JobStatus  @default(SCHEDULED)
  
  // Throttling and rate-limiting parameters
  delaySeconds       Int        @default(2) // Minimum delay between sends (mimics provider throttling)
  hourlyLimit        Int        @default(50) // Maximum emails per hour
  hourWindow         String?    // E.g. "2026-11-24T01" (bucket key for per-hour window tracking)
  
  // Execution metadata
  attempts           Int        @default(0)
  maxAttempts        Int        @default(3)
  errorMessage       String?    @db.Text
  etherealUrl        String?    @db.Text // Direct URL to view sent email on Ethereal fake SMTP
  messageId          String?    // SMTP transport message ID
  attachments        Json?      // Attached files (name, contentType, size, content base64)
  
  userId             String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@index([senderEmail, hourWindow])
  @@index([recipient])
  @@map("email_jobs")
}

model HourlyRateLimitTracker {
  id          String   @id @default(uuid())
  senderEmail String
  hourWindow  String   // Formatted: YYYY-MM-DD-HH
  sentCount   Int      @default(0)
  limit       Int
  alertSent   Boolean  @default(false) // Whether Slack notification has already been triggered for this hour window
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([senderEmail, hourWindow])
  @@index([senderEmail, hourWindow])
  @@map("hourly_rate_limit_trackers")
}

model SlackIntegration {
  id                 String    @id @default(uuid())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId             String?
  teamName           String?
  channelId          String?
  channelName        String?   @default("#reachinbox-scheduler-alerts")
  accessToken        String?   // OAuth Bot Token
  webhookUrl         String?   @db.Text // Incoming Webhook URL
  notifyOnRateLimit  Boolean   @default(true)
  lastNotifiedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("slack_integrations")
}
